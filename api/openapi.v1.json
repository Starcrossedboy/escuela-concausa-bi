  "info": {
    "description": "Contrato REST de FARO (Escuela como Sensor Social). Fuente de verdad: 03_Architecture/API_Specification.md. Este servicio publica el OpenAPI que consumen los mocks de las Células 2 y 3 (US-401).",
    "title": "FARO API — Contrato v1",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/export": {
      "get": {
        "description": "Exporta datos en bruto (rol: **analista**). En el stub devuelve una referencia, no el stream.",
        "operationId": "export_api_v1_admin_export_get",
        "parameters": [
          {
            "in": "query",
            "name": "tabla",
            "required": true,
            "schema": {
              "title": "Tabla",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "ciclo",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ciclo"
            }
          },
          {
            "in": "query",
            "name": "formato",
            "required": false,
            "schema": {
              "default": "csv",
              "title": "Formato",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Export Api V1 Admin Export Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Export",
        "tags": [
          "Administración"
        ]
      }
    },
    "/api/v1/admin/metrics": {
      "get": {
        "description": "Métricas internas (rol: **analista**): frescura por fuente y estado de suites GE.",
        "operationId": "metrics_api_v1_admin_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricsOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metrics",
        "tags": [
          "Administración"
        ]
      }
    },
    "/api/v1/admin/pipeline/run": {
      "post": {
        "description": "Encola una corrida de pipeline (rol: **analista**). Devuelve 202 accepted.",
        "operationId": "pipeline_run_api_v1_admin_pipeline_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PipelineRunIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineRunOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Pipeline Run",
        "tags": [
          "Administración"
        ]
      }
    },
    "/api/v1/agente/consulta": {
      "post": {
        "description": "Consulta en lenguaje natural sobre Gold (rol mínimo: ciudadano).",
        "operationId": "consulta_api_v1_agente_consulta_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgenteConsultaIn"
