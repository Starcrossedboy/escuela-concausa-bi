              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Me",
        "tags": [
          "Autenticación"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "description": "Canjea un refresh token válido por un par nuevo, re-resolviendo el rol con la política vigente.",
        "operationId": "refresh_api_v1_auth_refresh_post",
        "requestBody": {
