                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Consulta",
        "tags": [
          "Agente"
        ]
      }
    },
    "/api/v1/auth/callback": {
      "get": {
        "description": "Callback de Google: valida el `code`, resuelve el rol y emite el par de JWT.",
        "operationId": "callback_api_v1_auth_callback_get",
        "parameters": [
          {
            "in": "query",
            "name": "code",
            "required": true,
            "schema": {
              "title": "Code",
              "type": "string"
            }
