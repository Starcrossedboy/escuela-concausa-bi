              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Callback",
        "tags": [
          "Autenticación"
        ]
      }
    },
    "/api/v1/auth/login": {
      "get": {
        "description": "Inicia OAuth2 con Google redirigiendo a la pantalla de consentimiento.\n\nNota de seguridad: el `state` debe ser un valor aleatorio ligado a la sesión para prevenir CSRF;\nsu generación/almacenamiento se cierra al integrar el flujo e2e con credenciales reales (US-402).",
        "operationId": "login_api_v1_auth_login_get",
        "responses": {
          "302": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Login",
        "tags": [
          "Autenticación"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "description": "Devuelve el usuario autenticado (requiere access token válido; 401 en caso contrario).",
        "operationId": "me_api_v1_auth_me_get",
