{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "gcp_json": {
      "format": "{\"timestamp\":\"%(asctime)s\",\"severity\":\"%(levelname)s\",\"logger\":\"%(name)s\",\"message\":\"%(message)s\"}"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout",
      "formatter": "gcp_json"
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["console"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": ["console"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": ["console"],
      "level": "INFO",
      "propagate": false
    }
  }
}
